class Node{
    Node next;
    int data;
    Node(int d){
        this.data=d;
    }
}

class Main{
    static void print(Node a){
        Node t=a;
        while(t!=null){
            System.out.print(t.data+" ");
            t=t.next;
        }
    }
    static boolean cycle(Node a){
        Node slow=a;
        Node fast=a;
        while(fast!=null && fast.next!=null){
            slow=slow.next;
            fast=fast.next.next;
            if(slow==fast){
                return true;
            }
        }
        return false;
        
    }
    static Node merge(Node a,Node b){
        Node c=new Node(0);
        Node t=c;
        while(a!=null && b!=null){
            if(a.data<b.data){
                t.next=a;
                a=a.next;
            }else{
                t.next=b;
                b=b.next;
                
            }
            t=t.next;
        }
        if(a!=null){
            t.next=a;
        }
        if(b!=null){
            t.next=b;
        }
        return c.next;
    }
    public static void main(String[] args){
        Node head=new Node(10);
        head.next=new Node(20);
        head.next.next=new Node(30);
        
        Node hea=new Node(18);
        hea.next=new Node(21);
        hea.next.next=new Node(30);
        
        //head.next.next.next=head.next;
        Node y=merge(head,hea);
        print(y);
        
        //System.out.print(cycle(head));
    }
}
